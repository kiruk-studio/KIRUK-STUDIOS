---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';
import { href } from '../lib/base';
// The hand faces are the page's body text, not decoration: without a preload the
// first paint is system-sans and every line reflows when the real face lands.
import leftHand from '../assets/fonts/Left Hand.otf?url';
import magneticDrawing from '../assets/fonts/MagneticDrawing.ttf?url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'KIRUK-STUDIOS — scribbles into worlds',
  description = 'KIRUK-STUDIOS is a lab-led creative studio turning raw scribbles into shipped worlds. Building in public, starting with the ISM Lab and in-house products.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="preload" href={leftHand} as="font" type="font/otf" crossorigin />
    <link rel="preload" href={magneticDrawing} as="font" type="font/ttf" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
