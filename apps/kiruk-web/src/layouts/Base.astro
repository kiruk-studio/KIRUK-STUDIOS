---
// Bare shell while the studio is rebuilt from scratch. No styles, no fonts, no
// islands — the base layer gets designed in Phase 2, not inherited.
// spec-link: ideas/studio-dawn/plan.md — §2 Phase 0 (snapshot + cut)
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { href } from '../lib/base';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'kiruk — art + code studio',
  description = 'kiruk is a lab-led art + code studio, rebuilding its site from scratch in the open.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The favicon's ink flips with the colour scheme; let the page follow it too. -->
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
