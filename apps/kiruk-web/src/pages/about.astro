---
import Base from '../layouts/Base.astro';
import SketchNav from '../components/sketch/SketchNav.astro';
import PersonCrossLinks from '../components/sketch/PersonCrossLinks.astro';

// spec-link: FOUNDER_DECISIONS W6 — About is Just Arun for now
---

<Base title="about — kiruk" description="kiruk is a lab-led creative studio. Just Arun, for now.">
  <main class="relative mx-auto min-h-[100svh] max-w-2xl px-6 pb-28 pt-16">
    <p class="handwritten mb-2 text-base text-pencil">studio</p>
    <h1 class="font-display text-5xl leading-none text-ink md:text-6xl">about</h1>

    <div class="prose-body mt-8 max-w-xl space-y-5 text-lg leading-relaxed text-ink">
      <p>
        kiruk is a lab-led creative studio in Bangalore. Wild scribbles, drawn into worlds that
        don&rsquo;t exist yet.
      </p>
      <p>
        For now it is <strong>just Arun</strong> — Arun Kumaar Sreenivasan. kirukan and kirukargals
        land here when they actually join.
      </p>
      <p class="text-ink-soft">
        This is the studio, not a personal URL. The person keeps a handwritten notebook on the other
        host.
      </p>
    </div>

    <PersonCrossLinks />
    <SketchNav />
  </main>
</Base>
