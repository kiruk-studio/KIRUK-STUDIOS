---
import Base from '../../layouts/Base.astro';
import SketchNav from '../../components/sketch/SketchNav.astro';
import PersonCrossLinks from '../../components/sketch/PersonCrossLinks.astro';
import { href } from '../../lib/base';
import { listDevlogs } from '../../lib/devlogs';

const entries = listDevlogs();

function formatDate(iso: string) {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<Base title="devlog — kiruk" description="Studio process log. Scribbles becoming worlds, written as they happen.">
  <main class="relative mx-auto min-h-[100svh] max-w-2xl px-6 pb-28 pt-16">
    <p class="handwritten mb-2 text-base text-pencil">process</p>
    <h1 class="font-display text-5xl leading-none text-ink md:text-6xl">devlog</h1>
    <p class="prose-body mt-4 max-w-md text-lg leading-relaxed text-ink-soft">
      How the studio is made. Dated notes, not a magazine. The personal notebook lives with Arun.
    </p>

    {
      entries.length === 0 ? (
        <p class="prose-body mt-12 text-ink-soft">No process notes yet. Publish when there is something real.</p>
      ) : (
        <ul class="mt-12 space-y-10">
          {entries.map((entry) => (
            <li class="border-b border-rule pb-8">
              <p class="prose-body text-sm text-pencil">
                <time datetime={entry.date}>{formatDate(entry.date)}</time>
                {entry.state !== 'published' && (
                  <span class="ml-2 uppercase tracking-wider">· {entry.state}</span>
                )}
              </p>
              <a href={href(entry.url)} class="mt-2 block font-display text-2xl text-ink hover:underline md:text-3xl">
                {entry.title}
              </a>
              {entry.summary && <p class="prose-body mt-2 text-base leading-relaxed text-ink-soft">{entry.summary}</p>}
              {entry.tags.length > 0 && (
                <p class="prose-body mt-2 text-sm text-pencil">{entry.tags.join(' · ')}</p>
              )}
            </li>
          ))}
        </ul>
      )
    }

    <p class="prose-body mt-10 text-sm text-pencil">
      <a href={href('/devlog/rss.xml')} class="underline decoration-dotted underline-offset-4 hover:text-ink">
        RSS
      </a>
    </p>

    <PersonCrossLinks />
    <SketchNav />
  </main>
</Base>
