{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "three": ["./node_modules/@types/three"],
      "three/*": ["./node_modules/@types/three/*"]
    },
    "allowJs": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": false
  },
  "include": [".next/types/**/*.ts", "next-env.d.ts", "src/**/*", ".next-check/types/**/*.ts"],
  "exclude": ["node_modules"]
}
