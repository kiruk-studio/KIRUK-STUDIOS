{
  "color": {
    "bg": {
      "$type": "color",
      "$value": "{color.paper}",
      "$description": "Page background — white paper."
    },
    "fg": {
      "$type": "color",
      "$value": "{color.ink}",
      "$description": "Primary foreground — pen/pencil stroke."
    },
    "fg-muted": { "$type": "color", "$value": "{color.pencil-400}" },
    "surface": { "$type": "color", "$value": "{color.paper}" },
    "accent": {
      "$type": "color",
      "$value": "{color.ink}",
      "$description": "UI accent stays mono (ink). Absurd color is asset-only."
    },
    "accent-alt": { "$type": "color", "$value": "{color.pencil-500}" },
    "halo": { "$type": "color", "$value": "{color.pencil-200}" },
    "border": { "$type": "color", "$value": "{color.ink}" },
    "sheet": {
      "old": {
        "paper": {
          "$type": "color",
          "$value": "{color.dawn.light}",
          "$description": "Old sheet — a surface drawn as paper, the hand’s side of the dawn. Paper-drawn surfaces only (plates, their instruments), never app chrome."
        },
        "ink": {
          "$type": "color",
          "$value": "{color.dawn.iron-gall}",
          "$description": "Ink on the old sheet."
        }
      },
      "new": {
        "paper": {
          "$type": "color",
          "$value": "{color.dawn.departs}",
          "$description": "New sheet — a surface drawn as paper, the code’s side of the dawn. Paper-drawn surfaces only."
        },
        "ink": {
          "$type": "color",
          "$value": "{color.dawn.navy}",
          "$description": "Ink on the new sheet."
        }
      },
      "rubric": {
        "$type": "color",
        "$value": "{color.dawn.rubric}",
        "$description": "Measure and numbering type on either sheet."
      },
      "rubric-line": {
        "$type": "color",
        "$value": "{color.dawn.rubric-line}",
        "$description": "Rules and construction lines on either sheet."
      }
    }
  },
  "space": {
    "inline-xs": { "$type": "dimension", "$value": "{dimension.space.2}" },
    "inline-sm": { "$type": "dimension", "$value": "{dimension.space.3}" },
    "inline-md": { "$type": "dimension", "$value": "{dimension.space.4}" },
    "inline-lg": { "$type": "dimension", "$value": "{dimension.space.5}" },
    "stack-xs": { "$type": "dimension", "$value": "{dimension.space.3}" },
    "stack-sm": { "$type": "dimension", "$value": "{dimension.space.4}" },
    "stack-md": { "$type": "dimension", "$value": "{dimension.space.6}" },
    "stack-lg": { "$type": "dimension", "$value": "{dimension.space.8}" }
  }
}
