{
  "name": "@kiruk/design-system",
  "version": "0.0.1",
  "private": true,
  "description": "Kiruk design system \u2014 DTCG tokens, Eye SVG components, Style Dictionary build.",
  "type": "module",
  "exports": {
    ".": "./components/index.ts",
    "./components": "./components/index.ts",
    "./tokens/css": "./build/css/tokens.css",
    "./tokens/theme": "./build/css/theme.css",
    "./tokens/ts": "./build/ts/tokens.ts",
    "./tokens/tailwind": "./build/tailwind/tokens.cjs"
  },
  "scripts": {
    "tokens:build": "node ../../scripts/build-tokens.mjs",
    "tokens:watch": "node ../../scripts/build-tokens.mjs --watch",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "style-dictionary": "^4.3.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
